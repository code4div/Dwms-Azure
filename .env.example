# ==============================================================================
# DWMS - DIGITAL WEAR MONITORING SYSTEM
# SMTP Email Service Configuration
# ==============================================================================
# Add your SMTP server credentials below to enable automatic email notifications
# whenever a liner's wear percentage or thickness is updated in the UI.

# 1. SMTP Server Hostname
# Examples:
#   Gmail:        smtp.gmail.com
#   Outlook/365:  smtp.office365.com
#   SendGrid:     smtp.sendgrid.net
#   Mailgun:      smtp.mailgun.org
#   Amazon SES:   email-smtp.us-east-1.amazonaws.com
SMTP_HOST=smtp.gmail.com

# 2. SMTP Server Port
# 587 for TLS (STARTTLS), 465 for SSL, or 25
SMTP_PORT=587

# 3. Secure connection (true for port 465, false for port 587)
SMTP_SECURE=false

# 4. SMTP Authentication Credentials
# For Gmail, generate an "App Password" at: https://myaccount.google.com/apppasswords
SMTP_USER=akkisingh8266@gmail.com
SMTP_PASS=buvk ofeg xzpa dttn

# 5. Sender Display Name and Address
SMTP_FROM="DWMS Wear Monitoring" <akkisingh8266@gmail.com>

# 6. Recipient Email Address(es)
# Destination where automated liner update alerts and fleet health summaries are delivered
# (Use comma-separated addresses for multiple recipients)
ALERT_EMAIL_TO=divyanshu.chaudhary@beumer.com

# 7. Optional: Base Application URL for CTA buttons in emails
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ==============================================================================
# DWMS - PostgreSQL Database Configuration (Sequelize)
# ==============================================================================
DATABASE_URL="postgresql://postgres:Div@postgre1888@localhost:5432/DWMS_TestDB"

# Alternatively, configure individual parameters:
DB_HOST=localhost
DB_PORT=5432
DB_DATABASE=DWMS_TestDB
DB_USER=postgres
DB_PASSWORD=Div@postgre1888
